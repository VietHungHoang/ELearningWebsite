# AWS Configuration
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Bucket Configuration
AWS_S3_RAW_VIDEOS_BUCKET=raw-videos
AWS_S3_STREAMING_ASSETS_BUCKET=my-elearning-course-videos-stream

# SQS Configuration
AWS_SQS_TRANSCODING_QUEUE=video-transcoding-queue
AWS_SQS_DEAD_LETTER_QUEUE=video-transcoding-dlq
AWS_SQS_VISIBILITY_TIMEOUT=1800
AWS_SQS_MAX_RECEIVE_COUNT=3

# FFmpeg Configuration
FFMPEG_BINARY_PATH=ffmpeg
FFMPEG_HLS_SEGMENT_DURATION=10
FFMPEG_HLS_PLAYLIST_TYPE=vod

# Processing Configuration
PROCESSING_WORKSPACE_ROOT=/tmp/transcoding
PROCESSING_CLEANUP_AFTER_PROCESSING=true
PROCESSING_MAX_CONCURRENT_JOBS=2

# Course Service Configuration
COURSE_SERVICE_BASE_URL=http://localhost:8081
COURSE_SERVICE_UPDATE_VIDEO_STATUS_ENDPOINT=/api/courses/videos/{videoId}/status

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_TRANSCODING=DEBUG

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=development
SERVER_PORT=8085