# Multi-stage build for production
# Stage 1: Build
FROM maven:3.8.1-openjdk-17 AS builder

WORKDIR /build

# Copy pom.xml and download dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Copy source code
COPY src ./src

# Build application
RUN mvn clean package -DskipTests=true -q

# Stage 2: Runtime
FROM openjdk:17-jdk-slim

LABEL maintainer="E-Learning Platform"
LABEL version="1.0.0"
LABEL description="API Gateway - Production"

# Create app user (security best practice)
RUN useradd -m -u 1000 appuser

# Set working directory
WORKDIR /app

# Copy jar from builder stage
COPY --from=builder /build/target/apigateway-*.jar app.jar

# Create log directory
RUN mkdir -p /var/log/apigateway && chown appuser:appuser /var/log/apigateway

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 3000


# Run application with production profile
ENTRYPOINT ["java", \
    "-XX:+UseG1GC", \
    "-XX:MaxRAMPercentage=75.0", \
    "-XX:InitialRAMPercentage=50.0", \
    "-XX:+ParallelRefProcEnabled", \
    "-XX:+AlwaysPreTouch", \
    "-XX:+UseStringDeduplication", \
    "-Dspring.profiles.active=prod", \
    "-jar", \
    "app.jar"]
