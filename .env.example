# Whisper Transcription API - Environment Configuration

# Google Gemini API Key (required for text enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# Lesson Service API URL (external service that provides lesson context)
# Format: http://host:port/api
# Default: http://localhost:8000/api (if running locally)
LESSON_SERVICE_URL=http://localhost:8000/api

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Whisper Model (base)
# Default: base (recommended for balance of speed/quality)
WHISPER_MODEL=base
# CUDA_VISIBLE_DEVICES=0
