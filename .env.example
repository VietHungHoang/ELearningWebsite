# Whisper Transcription API - Environment Configuration

# Google Gemini API Key (required for text enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# Lesson Service API URL (external service that provides lesson context)
# Format: http://host:port/api
LESSON_SERVICE_URL=http://lesson-service:8000/api

# Optional: Lesson Service Database URL (if running Lesson Service locally)
# LESSON_SERVICE_DB_URL=postgresql://user:password@localhost:5432/lessons

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Whisper Model (options: tiny, base, small, medium, large)
WHISPER_MODEL=base

# Optional: CUDA configuration for GPU acceleration
# CUDA_VISIBLE_DEVICES=0
